#. Plugin Name of the plugin
#: tourfic.php
msgid "Tourfic – Travel Booking, Hotel Booking & Car Rental WordPress Plugin"
msgstr ""
"Tourfic – Plugin WordPress per prenotazioni viaggi, prenotazioni hotel e "
"noleggio auto"

#. Plugin URI of the plugin
#: tourfic.php
msgid "https://themefic.com/tourfic"
msgstr "https://themefic.com/tourfic"

#. Description of the plugin
#: tourfic.php
msgid ""
"The ultimate plugin for tour, travel, accommodation, and hotel bookings. "
"Effortlessly manage your entire online travel booking system, including "
"orders and any WooCommerce payment method."
msgstr ""
"Il plugin definitivo per prenotazioni di tour, viaggi, alloggi e hotel. "
"Gestisci senza sforzo l'intero sistema di prenotazione di viaggi online, "
"inclusi gli ordini e qualsiasi metodo di pagamento WooCommerce."

#. Author of the plugin
#: tourfic.php
msgid "Themefic"
msgstr "Themefic"

